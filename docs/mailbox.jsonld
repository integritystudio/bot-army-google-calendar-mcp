    {
      "@type": "DefinedTerm",
      "@id": "https://en.wikipedia.org/wiki/Remote_work",
      "name": "Remote Workers",
      "description": "People who work at or from home or another space rather than from an office or workplace (Wikipedia). Broader than Digital Nomads: it carries no implication of travel, so it fits remote-job boards and distributed-team tooling that a location-independence term would overclaim.",
      "inDefinedTermSet": {
        "@type": "DefinedTermSet",
        "name": "Mailbox Audience Terms",
        "description": "Audience segments an organization serves, for use in Organization.keywords."
      },
      "sameAs": "https://en.wikipedia.org/wiki/Remote_work"
    },
