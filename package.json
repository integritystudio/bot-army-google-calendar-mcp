{
  "name": "@cocal/google-calendar-mcp",
  "version": "1.4.9",
  "description": "Google Calendar MCP Server with extensive support for calendar management",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "google-calendar-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-calendar",
    "calendar",
    "ai",
    "llm",
    "integration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nspady/google-calendar-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nspady/google-calendar-mcp/issues"
  },
  "homepage": "https://github.com/nspady/google-calendar-mcp#readme",
  "author": "nspady",
  "license": "MIT",
  "overrides": {
    "googleapis-common": "8.0.1"
  },
  "scripts": {
    "start": "node build/index.js",
    "build": "node scripts/build.js && node build/verify-tokens.js",
    "auth": "node build/auth-server.js",
    "serve": "npm run auth && npm start",
    "serve:personal": "GOOGLE_ACCOUNT_MODE=personal npm run serve",
    "serve:alyshia": "GOOGLE_ACCOUNT_MODE=alyshia npm run serve",
    "verify-tokens": "GOOGLE_OAUTH_CREDENTIALS=./gcp-oauth.keys.json npx vite-node src/verify-tokens.ts",
    "dev": "node scripts/dev.js",
    "check-duplicates": "node scripts/check-duplicates.mjs src 6",
    "build:jsonld": "node build-jsonld.mjs",
    "check:jsonld": "node build-jsonld.mjs --check",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "with-dev-creds": "GOOGLE_ACCOUNT_MODE=normal GOOGLE_OAUTH_CREDENTIALS=./gcp-oauth.keys.json doppler run --project integrity-studio --config dev --",
    "test": "vitest run src/tests/unit",
    "test:watch": "vitest src/tests/unit",
    "test:integration": "npm run with-dev-creds -- vitest run src/tests/integration",
    "test:all": "npm run with-dev-creds -- vitest run src/tests",
    "test:coverage": "vitest run src/tests/unit --coverage",
    "test:doppler": "npm run with-dev-creds -- npm test",
    "start:http": "node build/index.js --transport http --port 3000",
    "start:http:public": "node build/index.js --transport http --port 3000 --host 0.0.0.0",
    "repomix": "bash scripts/repomix/repomix-regen.sh",
    "list-unlabeled-unread": "node list-unlabeled-unread.mjs"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^10.47.0",
    "date-fns": "^4.1.0",
    "esbuild": "^0.28.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "htmlparser2": "^12.0.0",
    "lodash-es": "^4.18.1",
    "open": "^11.0.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.3",
    "openai": "^6.34.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
